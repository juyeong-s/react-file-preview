{
  "name": "@ruby-s/react-file-preview",
  "version": "0.1.1",
  "description": "One React component to preview PDF, Word, Excel, images, video, audio and text — fully client-side, lazy-loaded per format.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/juyeong-s/react-file-preview.git",
    "directory": "packages/react-file-preview"
  },
  "homepage": "https://github.com/juyeong-s/react-file-preview#readme",
  "bugs": {
    "url": "https://github.com/juyeong-s/react-file-preview/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    },
    "./renderers": {
      "types": "./dist/renderers.d.ts",
      "import": "./dist/renderers.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "keywords": [
    "react",
    "file-viewer",
    "document-viewer",
    "pdf",
    "docx",
    "xlsx",
    "preview"
  ],
  "scripts": {
    "gen": "node scripts/gen-pdf-worker.mjs",
    "build": "pnpm gen && tsup && node scripts/postbuild.mjs",
    "dev": "pnpm gen && tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "prepublishOnly": "pnpm build && pnpm test"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.14.13",
    "docx-preview": "^0.4.1",
    "dompurify": "^3.4.16",
    "marked": "^18.0.14",
    "pdfjs-dist": "6.3.289",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^30.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsup": "^8.5.1",
    "typescript": "~6.0.3",
    "vitest": "^5.0.2"
  }
}
